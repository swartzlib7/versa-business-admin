# Data source flag (cutover control)
# fixture = in-memory fixtures (default, no DB required)
# postgres = hybrid Phase 2: User list/get + login hash from Postgres; other resources still fixture
DATA_SOURCE=fixture

# Postgres (required when DATA_SOURCE=postgres)
DATABASE_URL=postgresql://mission:mission@localhost:5432/business_admin

# Optional: connection pool size
DB_POOL_SIZE=10

# Auth session cookie. Firebase Hosting only forwards `__session` to Cloud Functions.
AUTH_COOKIE_NAME=__session
AUTH_SESSION_MAX_AGE=604800
