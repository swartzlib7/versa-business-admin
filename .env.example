# Database (Phase 1 — local Docker Postgres)
DATABASE_URL=postgresql://mission:mission@localhost:5432/mission_control

# Data source flag (cutover control)
# fixture = use in-memory fixture data (default, no DB required)
# postgres = use Postgres via Drizzle ORM (requires DATABASE_URL)
DATA_SOURCE=fixture

# Auth (existing — keep for session)
AUTH_COOKIE_NAME=versa_session
AUTH_SESSION_MAX_AGE=604800

# Optional: connection pool size
DB_POOL_SIZE=10
