# Shipped default: Postgres. Connection lives only in this file (never commit).
DATA_SOURCE=postgres

# Required when DATA_SOURCE=postgres
# Local example after: sudo bash scripts/provision-local-postgres.sh
DATABASE_URL=postgresql://versa_ba:CHANGE_ME@127.0.0.1:5432/business_admin

# Optional: connection pool size
DB_POOL_SIZE=10

# Opt-in in-memory fixtures for tests without a database:
# DATA_SOURCE=fixture

# Auth session cookie. Firebase Hosting only forwards `__session` to Cloud Functions.
AUTH_COOKIE_NAME=__session
AUTH_SESSION_MAX_AGE=604800
